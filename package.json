{
  "name": "localtake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "typecheck": "node scripts/vue-tsc.mjs --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build --config apps/client/vite.config.ts && node scripts/build-sw.mjs",
    "start": "node dist/apps/server/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write apps packages tests scripts *.json *.ts deploy/*.yaml",
    "format:check": "prettier --check apps packages tests scripts *.json *.ts deploy/*.yaml"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@lucide/vue": "^1.52.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "mediabunny": "^1.60.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@types/ws": "^8.18.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.12"
  }
}
