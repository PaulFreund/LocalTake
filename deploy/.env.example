DOMAIN=studio.example.com
ROOM_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
# Opt in after configuring a reachable authenticated relay.
TURN_ENABLED=false
# all: prefer direct routes; relay: force TURN and omit STUN for a temporary test.
ICE_TRANSPORT_POLICY=all
TURN_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-an-independent-random-secret
TURN_PUBLIC_IP=
